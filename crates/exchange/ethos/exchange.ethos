Library
[]                                                     ; imports
[ ComponentName.String                                 ; types
  ComponentTitle.String
  PublicNexusSocket.String
  MetaNexusSocket.String
  PublicTranslatorSocket.String
  MetaTranslatorSocket.String
  SocketNames.{ PublicNexusSocket MetaNexusSocket
                PublicTranslatorSocket MetaTranslatorSocket }
  MemoryFile.String                                    ; the Nexus's Memory, in its place's state directory
  Lane.[ PublicText MetaText EmissionSignal ]
  Kind.[ Request Answered Failed Ended ]                ; a text answer ends Ended or Failed
  FrameDeadlineMilliseconds.Integer
  FrameCapacityBytes.Integer
  RetryDelayMilliseconds.Integer
  Admission.{ FrameDeadlineMilliseconds FrameCapacityBytes RetryDelayMilliseconds }
  LaneFault.String
  LaneFailure.[ Unsubmitted.LaneFault                  ; not sent whole: it did not happen
                Declined.LaneFault                     ; refused by the translator unread or undone
                Unanswered.LaneFault ] ]               ; sent, no answer read: it may have happened
[ Named.[ name:[ ComponentName ]                       ; traits
          title:[ ComponentTitle ] ]
  SocketNaming.[ socket_names.[ SocketNames ] ]
  MemoryNaming.[ memory_file.[ MemoryFile ] ]
  LaneFailing.[ lane_failed:{ [ LaneFailure ] [ Self ] } ] ]  ; an emission outcome, failed on its lane
[ ComponentName.[ SocketNaming MemoryNaming ] ]        ; associations
